# Copy to .env (or export directly) and fill in before running `make test-pg`.
# POSTGRES_URL is read by openTestDB in integration_pg_test.go (build tag
# `integration`) — the tests apply their own DDL (postgres.DDL +
# BlobSearchIndexDDL) against this database on each run, idempotently.
#
# Quick local instance: scripts/local-postgres.sh
POSTGRES_URL=postgres://gituser:gitpass@localhost:55488/mwanachama_git_test?sslmode=disable
