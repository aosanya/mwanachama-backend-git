        {
          "from": "query",
          "as": "root",
          "description": "The keyword to start from. Empty starts at the roots."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "get_keyword": {
      "method": "GET",
      "path": "/keywords/{keywordID}",
      "call": "GetKeyword",
      "action": "git.keyword.read",
      "title": "Read keyword",
      "description": "Read one keyword and the ids of its direct children.",
      "args": [
        {
          "from": "path",
          "as": "keywordID",
          "description": "The keyword to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "update_keyword": {
      "method": "PUT",
      "path": "/keywords/{keywordID}",
      "call": "UpdateKeyword",
      "action": "git.keyword.update",
      "title": "Update keyword",
      "description": "Change a keyword's name, description, scope or parent.",
