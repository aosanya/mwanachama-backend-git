      "method": "DELETE",
      "path": "/edges",
      "call": "DeleteEdge",
      "action": "git.edge.delete",
      "status": 204,
      "title": "Delete relationship",
      "description": "Remove a named relationship between two files on one branch.",
      "args": [
        {
          "from": "body",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
