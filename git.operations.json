      "call": "CreateKeyword",
      "action": "git.keyword.create",
      "status": 201,
      "title": "Create keyword",
      "description": "Add a label to the taxonomy, optionally under a parent.",
      "args": [
        {
          "from": "body",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "list_keywords": {
      "method": "GET",
      "path": "/keywords",
      "call": "ListKeywords",
      "action": "git.keyword.list",
