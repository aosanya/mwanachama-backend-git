{
  "operations": {
    "init_repo": {
      "method": "POST",
      "path": "/repos",
      "call": "InitRepo",
      "action": "git.repository.init",
      "status": 201,
      "title": "Create repository",
      "description": "Create an empty repository with a default branch. The name must not already be taken.",
      "args": [
        {
          "from": "body",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "get_repository": {
      "method": "GET",
      "path": "/repos/{repoID}",
      "call": "GetRepository",
      "action": "git.repository.read",
      "title": "Read repository",
      "description": "Read one repository by its storage key.",
      "args": [
        {
          "from": "path",
          "as": "repoID",
          "description": "The repository to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "delete_repo": {
      "method": "DELETE",
      "path": "/repos/{repoID}",
      "call": "DeleteRepo",
      "action": "git.repository.delete",
      "status": 204,
      "title": "Delete repository",
      "description": "Remove a repository from view. Its history is left in place; use purge to reclaim the storage.",
      "args": [
        {
          "from": "path",
          "as": "repoID",
          "description": "The repository to remove."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "purge_repo": {
      "method": "POST",
      "path": "/repos/{repoID}/purge",
      "call": "PurgeRepo",
      "action": "git.repository.purge",
      "status": 204,
      "title": "Purge repository",
      "description": "Delete a repository and every commit, tree, blob, branch and tag reachable only from it. Not reversible.",
      "args": [
        {
          "from": "path",
          "as": "repoID",
          "description": "The repository to purge."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "create_branch": {
      "method": "POST",
      "path": "/repos/{repoID}/branches",
      "call": "CreateBranch",
      "action": "git.branch.create",
      "status": 201,
      "title": "Create branch",
      "description": "Start a new branch in a repository, pointing at the tip it is cut from.",
      "args": [
        {
          "from": "body",
          "whole": true
        },
        {
          "from": "path",
          "as": "repoID",
          "into": "RepositoryID",
          "description": "The repository the branch belongs to. The address decides this, not the body."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "get_branch": {
      "method": "GET",
      "path": "/branches/{branchID}",
      "call": "GetBranch",
      "action": "git.branch.read",
      "title": "Read branch",
      "description": "Read one branch by its storage key.",
      "args": [
        {
          "from": "path",
          "as": "branchID",
          "description": "The branch to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "delete_branch": {
      "method": "DELETE",
      "path": "/branches/{branchID}",
      "call": "DeleteBranch",
      "action": "git.branch.delete",
      "status": 204,
      "title": "Delete branch",
      "description": "Remove a branch. A repository's default branch may not be deleted.",
      "args": [
        {
          "from": "path",
          "as": "branchID",
          "description": "The branch to remove."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "create_tag": {
      "method": "POST",
      "path": "/repos/{repoID}/tags",
      "call": "CreateTag",
      "action": "git.tag.create",
      "status": 201,
      "title": "Create tag",
      "description": "Freeze a name against a commit. Once created, what a tag points at never changes.",
      "args": [
        {
          "from": "body",
          "whole": true
        },
        {
          "from": "path",
          "as": "repoID",
          "into": "RepositoryID",
          "description": "The repository the tag belongs to. The address decides this, not the body."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "list_tags": {
      "method": "GET",
      "path": "/repos/{repoID}/tags",
      "call": "ListTags",
      "action": "git.tag.list",
      "title": "List tags",
      "description": "Every tag in one repository.",
      "args": [
        {
          "from": "path",
          "as": "repoID",
          "description": "The repository whose tags to list."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "get_tag": {
      "method": "GET",
      "path": "/tags/{tagID}",
      "call": "GetTag",
      "action": "git.tag.read",
      "title": "Read tag",
      "description": "Read one tag by its storage key.",
      "args": [
        {
          "from": "path",
          "as": "tagID",
          "description": "The tag to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "delete_tag": {
      "method": "DELETE",
      "path": "/tags/{tagID}",
      "call": "DeleteTag",
      "action": "git.tag.delete",
      "status": 204,
      "title": "Delete tag",
      "description": "Remove a tag. The commit it pointed at is untouched.",
      "args": [
        {
          "from": "path",
          "as": "tagID",
          "description": "The tag to remove."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "create_merge_request": {
      "method": "POST",
      "path": "/merge-requests",
      "call": "CreateMergeRequest",
      "action": "git.merge_request.create",
      "status": 201,
      "title": "Open merge request",
      "description": "Ask for one branch's work to be merged into another. The target falls back to the repository's default branch.",
      "args": [
        {
          "from": "body",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "list_merge_requests": {
      "method": "GET",
      "path": "/merge-requests",
      "call": "ListMergeRequests",
      "action": "git.merge_request.list",
      "title": "List merge requests",
      "description": "The merge requests matching the filter. Narrow by repository, by state, or by the orchestrated run that opened them.",
      "args": [
        {
          "from": "query",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "get_merge_request": {
      "method": "GET",
      "path": "/merge-requests/{mrID}",
      "call": "GetMergeRequest",
      "action": "git.merge_request.read",
      "title": "Read merge request",
      "description": "Read one merge request by its storage key.",
      "args": [
        {
          "from": "path",
          "as": "mrID",
          "description": "The merge request to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "complete_merge_request": {
      "method": "POST",
      "path": "/merge-requests/{mrID}/complete",
      "call": "CompleteMergeRequest",
      "action": "git.merge_request.complete",
      "title": "Complete merge request",
      "description": "Merge the request's source branch into its target and record the resulting tip. Only an open request can be completed.",
      "args": [
        {
          "from": "path",
          "as": "mrID",
          "description": "The merge request to complete."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "close_merge_request": {
      "method": "POST",
      "path": "/merge-requests/{mrID}/close",
      "call": "CloseMergeRequest",
      "action": "git.merge_request.close",
      "title": "Close merge request",
      "description": "Close a request without merging it. Only an open request can be closed.",
      "args": [
        {
          "from": "path",
          "as": "mrID",
          "description": "The merge request to close."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "rollback_workflow_run": {
      "method": "POST",
      "path": "/workflow-runs/{workflowRunID}/rollback",
      "call": "RollbackByWorkflowRun",
      "action": "git.workflow_run.rollback",
      "title": "Roll back a run",
      "description": "Undo every merge one orchestrated run produced, newest first, and report what was reverted and what was skipped.",
      "args": [
        {
          "from": "path",
          "as": "workflowRunID",
          "description": "The run to undo."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "write_file": {
      "method": "POST",
      "path": "/branches/{branchID}/files",
      "call": "WriteFile",
      "action": "git.file.write",
      "status": 201,
      "title": "Write file",
      "description": "Write a file on a branch and record the commit that carries it.",
      "args": [
        {
          "from": "body",
          "whole": true
        },
        {
          "from": "path",
          "as": "branchID",
          "into": "BranchID",
          "description": "The branch to write on. The address decides this, not the body."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "read_file": {
      "method": "GET",
      "path": "/branches/{branchID}/files",
      "call": "ReadFile",
      "action": "git.file.read",
      "title": "Read file",
      "description": "Read one file's content as it stands on a branch.",
      "args": [
        {
          "from": "path",
          "as": "branchID",
          "description": "The branch to read from."
        },
        {
          "from": "query",
          "as": "path",
          "description": "The file path from the repository root.",
          "required": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "delete_file": {
      "method": "DELETE",
      "path": "/branches/{branchID}/files",
      "call": "DeleteFile",
      "action": "git.file.delete",
      "title": "Delete file",
      "description": "Remove a file on a branch and record the commit that removes it.",
      "args": [
        {
          "from": "body",
          "whole": true
        },
        {
          "from": "path",
          "as": "branchID",
          "into": "BranchID",
          "description": "The branch to delete from. The address decides this, not the body."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "list_directory": {
      "method": "GET",
      "path": "/branches/{branchID}/directory",
      "call": "ListDirectory",
      "action": "git.directory.list",
      "title": "List directory",
      "description": "The files and directories directly inside one path on a branch.",
      "args": [
        {
          "from": "path",
          "as": "branchID",
          "description": "The branch to list on."
        },
        {
          "from": "query",
          "as": "path",
          "description": "The directory path. Empty lists the repository root."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "log": {
      "method": "GET",
      "path": "/branches/{branchID}/log",
      "call": "Log",
      "action": "git.commit.log",
      "title": "Read history",
      "description": "The commits reachable from a branch tip, newest first, optionally narrowed to one path.",
      "args": [
        {
          "from": "path",
          "as": "branchID",
          "description": "The branch whose history to walk."
        },
        {
          "from": "query",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "diff": {
      "method": "GET",
      "path": "/diff",
      "call": "Diff",
      "action": "git.commit.diff",
      "title": "Diff two refs",
      "description": "The per-file changes between two refs, as unified diff text.",
      "args": [
        {
          "from": "query",
          "as": "from",
          "description": "The ref to compare from.",
          "required": true
        },
        {
          "from": "query",
          "as": "to",
          "description": "The ref to compare to.",
          "required": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "import_repo": {
      "method": "POST",
      "path": "/imports",
      "call": "ImportRepo",
      "action": "git.import.start",
      "status": 202,
      "title": "Import repository",
      "description": "Start cloning a public repository in the background. No credentials are accepted, so a private repository cannot be imported.",
      "args": [
        {
          "from": "body",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "get_import_status": {
      "method": "GET",
      "path": "/imports/{jobID}",
      "call": "GetImportStatus",
      "action": "git.import.read",
      "title": "Read import status",
      "description": "How far an import has got, and why it failed if it did.",
      "args": [
        {
          "from": "path",
          "as": "jobID",
          "description": "The import job to read."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "cancel_import": {
      "method": "POST",
      "path": "/imports/{jobID}/cancel",
      "call": "CancelImport",
      "action": "git.import.cancel",
      "status": 204,
      "title": "Cancel import",
      "description": "Stop an import that is still running. One that has already finished cannot be cancelled.",
      "args": [
        {
          "from": "path",
          "as": "jobID",
          "description": "The import job to stop."
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "create_keyword": {
      "method": "POST",
