        {
          "from": "path",
          "as": "keywordID",
          "description": "The keyword to change."
        },
        {
          "from": "body",
          "whole": true
        }
      ],
      "returns": [
        {
          "body": true
        }
      ]
    },
    "delete_keyword": {
      "method": "DELETE",
      "path": "/keywords/{keywordID}",
      "call": "DeleteKeyword",
      "action": "git.keyword.delete",
      "status": 204,
      "title": "Delete keyword",
